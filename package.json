{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve:env\" \"vite\" --names=server,vite --kill-others",
        "build": "vite build",
        "preview": "vite preview",
        "type-check": "tsc --noEmit && php vendor/bin/phpstan analyse --memory-limit=512M",
        "lint": "eslint . && php vendor/bin/pint --test",
        "format": "prettier --write . && php vendor/bin/pint",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@shufo/prettier-plugin-blade": "^1.16.3",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.11",
        "concurrently": "^10.0.7",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.2.1",
        "lint-staged": "^17.6.2",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.4.0"
    },
    "dependencies": {
        "@types/alpinejs": "^3.17.0",
        "alpinejs": "^3.17.5",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.1",
        "zod": "^4.6.7"
    },
    "lint-staged": {
        "*.php": [
            "php vendor/bin/pint"
        ],
        "*.blade.php": [
            "prettier --write"
        ],
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    }
}
