{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vite/client", "node"],
        "paths": {
            "@/*": ["./resources/js/*"]
        }
    },
    "include": ["resources/js/**/*.ts", "vite.config.ts"],
    "exclude": ["node_modules", "vendor", "public/build"]
}
